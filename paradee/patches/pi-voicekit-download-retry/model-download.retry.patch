+	let cursor: any = err;
+	let depth = 0;
+	while (cursor && depth++ < 5) {
+		const msg = typeof cursor.message === "string" ? cursor.message : String(cursor);
+		parts.push(cursor.code ? `${msg} (${cursor.code})` : msg);
+		cursor = cursor.cause;
+	}
+	return [...new Set(parts)].join(" — ");
+}
