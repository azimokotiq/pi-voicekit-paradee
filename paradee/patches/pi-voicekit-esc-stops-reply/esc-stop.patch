+/**
+ * Mark every queued auto-speak stream as cancelled so [esc] stops the whole
+ * reply instead of only the utterance currently playing.
+ *
+ * pi-voicekit 0.4.2 splits a streaming reply into sentence-sized chunks and
+ * chains them (`state.pending = state.pending.then(() => runSpeak(…))`), while
+ * the playback indicator's stop and /voice-speak-stop only abort the ACTIVE
+ * utterance — so every chunk already queued behind it still starts in turn and
+ * speech "restarts on the next paragraph" however often esc is pressed. Returns
+ * the number of streams whose remaining chunks were dropped.
+ */
+export function cancelMessageStreams(streams: Map<string, { cancelled: boolean }>): number {
+	let dropped = 0;
+	for (const state of streams.values()) {
+		if (!state.cancelled) {
+			state.cancelled = true;
+			dropped++;
+		}
+	}
+	return dropped;
+}
