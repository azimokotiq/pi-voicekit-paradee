+/**
+ * Which tar to spawn — and why it matters on Windows.
+ *
+ * Windows ships bsdtar as `C:\Windows\System32\tar.exe`, and CreateProcess
+ * searches System32 BEFORE PATH, so `spawn("tar")` gets bsdtar even when pi runs
+ * from Git Bash. bsdtar on Windows has NO internal bzip2: `-j` is implemented as
+ * the external filter program `bzip2 -d`. When Git Bash's MSYS bzip2.exe happens
+ * to be on PATH, bsdtar launches it and the pipe deadlocks after ~140 KB — the
+ * install then sits at "Extracting…" forever with tar using no CPU at all. With
+ * no bzip2 on PATH it instead fails fast. GNU tar (Git Bash / MSYS2) links bzip2
+ * in and extracts the same archive in seconds, so prefer it by absolute path.
+ */
+let cachedTar: string | null | undefined;
+
+function isGnuTar(bin: string): boolean {
+	try {
+		const r = spawnSync(bin, ["--version"], { encoding: "utf8", timeout: 5000 });
+		return /GNU tar/i.test(r.stdout ?? "");
+	} catch {
+		return false;
+	}
+}
+
+export function resolveTar(): string {
+	if (cachedTar !== undefined) return cachedTar ?? "tar";
+	let chosen: string | null = null;
+	if (process.platform === "win32") {
+		const system = path
+			.join(process.env.SystemRoot ?? "C:\\Windows", "System32", "tar.exe")
+			.toLowerCase();
+		const seen = new Set<string>();
+		for (const dir of (process.env.PATH ?? "").split(path.delimiter)) {
+			if (!dir) continue;
+			const cand = path.join(dir, "tar.exe");
+			const key = cand.toLowerCase();
+			if (seen.has(key) || key === system) continue;
+			seen.add(key);
+			if (!fs.existsSync(cand)) continue;
+			if (isGnuTar(cand)) {
+				chosen = cand;
+				break;
+			}
+		}
+	}
+	cachedTar = chosen;
+	return chosen ?? "tar";
+}
