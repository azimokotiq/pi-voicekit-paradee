+const EXTRACT_STALL_MS = 60_000;
+
+/** True iff nothing under `dir` has been created/modified for `stallMs` (measured from `nowMs`). */
+export function extractStalled(dir: string, startedAtMs: number, nowMs: number, stallMs = EXTRACT_STALL_MS): boolean {
+	let newest = startedAtMs;
+	try {
+		for (const name of fs.readdirSync(dir)) {
+			try {
+				newest = Math.max(newest, fs.statSync(path.join(dir, name)).mtimeMs);
+			} catch {
+				// raced with a rename/unlink — ignore this entry
+			}
+		}
+	} catch {
+		return false; // directory vanished; the close handler reports the real error
+	}
+	return nowMs - newest >= stallMs;
+}
